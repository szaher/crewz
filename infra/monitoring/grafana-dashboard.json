{
  "dashboard": {
    "id": null,
    "uid": "worker-architecture-monitoring",
    "title": "Worker Architecture - Execution Monitoring",
    "description": "Monitoring dashboard for isolated worker architecture with async execution",
    "tags": ["workers", "executions", "queue", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    },
    "panels": [
      {
        "id": 1,
        "type": "graph",
        "title": "Queue Depth Over Time",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "execution_queue_depth",
            "legendFormat": "Queue Depth",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "yaxes": [
          {
            "label": "Jobs in Queue",
            "show": true
          }
        ],
        "alert": {
          "name": "High Queue Depth",
          "conditions": [
            {
              "evaluator": {
                "params": [100],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "type": "query"
            }
          ],
          "frequency": "1m",
          "message": "Execution queue depth exceeds 100 jobs"
        }
      },
      {
        "id": 2,
        "type": "graph",
        "title": "Worker CPU Usage",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "worker_cpu_usage_percent",
            "legendFormat": "Worker {{worker_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "yaxes": [
          {
            "label": "CPU %",
            "max": 100,
            "show": true
          }
        ]
      },
      {
        "id": 3,
        "type": "graph",
        "title": "Worker Memory Usage",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "worker_memory_usage_mb",
            "legendFormat": "Worker {{worker_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "yaxes": [
          {
            "label": "Memory (MB)",
            "format": "bytes",
            "show": true
          }
        ],
        "alert": {
          "name": "High Memory Usage",
          "conditions": [
            {
              "evaluator": {
                "params": [3500],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "type": "query"
            }
          ],
          "frequency": "1m",
          "message": "Worker memory usage exceeds 3.5GB (approaching 4GB limit)"
        }
      },
      {
        "id": 4,
        "type": "graph",
        "title": "Execution Throughput",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(execution_completed_total[5m])",
            "legendFormat": "Completions/sec",
            "refId": "A"
          },
          {
            "expr": "rate(execution_started_total[5m])",
            "legendFormat": "Started/sec",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "yaxes": [
          {
            "label": "Executions/sec",
            "show": true
          }
        ]
      },
      {
        "id": 5,
        "type": "graph",
        "title": "Execution Error Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(execution_failed_total[5m])",
            "legendFormat": "Failures/sec",
            "refId": "A"
          },
          {
            "expr": "rate(execution_cancelled_total[5m])",
            "legendFormat": "Cancelled/sec",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "yaxes": [
          {
            "label": "Errors/sec",
            "show": true
          }
        ],
        "alert": {
          "name": "High Error Rate",
          "conditions": [
            {
              "evaluator": {
                "params": [0.5],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "type": "query"
            }
          ],
          "frequency": "1m",
          "message": "Execution error rate exceeds 0.5 failures/sec"
        }
      },
      {
        "id": 6,
        "type": "graph",
        "title": "P95 Execution Latency",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(execution_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(execution_duration_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(execution_duration_seconds_bucket[5m]))",
            "legendFormat": "P99 Latency",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "yaxes": [
          {
            "label": "Duration (seconds)",
            "format": "s",
            "show": true
          }
        ],
        "alert": {
          "name": "High P95 Latency",
          "conditions": [
            {
              "evaluator": {
                "params": [300],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "type": "query"
            }
          ],
          "frequency": "1m",
          "message": "P95 execution latency exceeds 5 minutes"
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Active Workers",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "count(worker_status{status=\"active\"})",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 24
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "green",
                  "value": 2
                }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "type": "stat",
        "title": "Crashed Workers",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "count(worker_status{status=\"crashed\"})",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 24
        },
        "options": {
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "type": "stat",
        "title": "Queue Wait Time (Avg)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(execution_queue_wait_seconds)",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 8,
          "y": 24
        },
        "options": {
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 30
                },
                {
                  "color": "red",
                  "value": 60
                }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "type": "table",
        "title": "Worker Status Details",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "worker_status",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "worker_id": "Worker ID",
                "status": "Status",
                "current_job_id": "Current Job",
                "last_heartbeat_at": "Last Heartbeat"
              }
            }
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Worker Restarts",
          "datasource": "Prometheus",
          "expr": "changes(worker_start_time[5m]) > 0",
          "tagKeys": "worker_id",
          "titleFormat": "Worker Restart",
          "textFormat": "Worker {{worker_id}} restarted"
        },
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "expr": "changes(app_version[5m]) > 0",
          "titleFormat": "Deployment",
          "textFormat": "New version deployed"
        }
      ]
    }
  },
  "overwrite": true
}
