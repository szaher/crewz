        SET tenant_uuid = tm.new_uuid,
            user_uuid = um.new_uuid
        FROM tenants_id_mapping tm, users_id_mapping um
        WHERE n.tenant_id = tm.old_id
          AND n.user_id = um.old_id
    """)
    _migrate_table_to_uuid(
        table_name='notifications',
        foreign_keys=[
            {'old_col': 'tenant_id', 'new_col': 'tenant_uuid', 'ref_table': 'tenants'},
            {'old_col': 'user_id', 'new_col': 'user_uuid', 'ref_table': 'users'}
        ],
    )

    # ===================================================================
    # FEEDBACK TABLE (FKs: tenant_id, user_id, execution_id, agent_id)
    # ===================================================================
    print("\n  Processing: feedback table")
    op.add_column('feedback', sa.Column('tenant_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.add_column('feedback', sa.Column('user_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.add_column('feedback', sa.Column('execution_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.add_column('feedback', sa.Column('agent_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE feedback f
        SET tenant_uuid = tm.new_uuid,
            user_uuid = um.new_uuid,
            execution_uuid = em.new_uuid,
            agent_uuid = am.new_uuid
        FROM tenants_id_mapping tm, users_id_mapping um, executions_id_mapping em, agents_id_mapping am
        WHERE f.tenant_id = tm.old_id
          AND f.user_id = um.old_id
          AND (f.execution_id = em.old_id OR f.execution_id IS NULL)
          AND (f.agent_id = am.old_id OR f.agent_id IS NULL)
    """)
    _migrate_table_to_uuid(
        table_name='feedback',
        foreign_keys=[
            {'old_col': 'tenant_id', 'new_col': 'tenant_uuid', 'ref_table': 'tenants'},
            {'old_col': 'user_id', 'new_col': 'user_uuid', 'ref_table': 'users'},
            {'old_col': 'execution_id', 'new_col': 'execution_uuid', 'ref_table': 'executions'},
            {'old_col': 'agent_id', 'new_col': 'agent_uuid', 'ref_table': 'agents'}
        ],
    )

    # ===================================================================
    # VERSION TABLES
    # ===================================================================
    print("\n  Processing: agent_versions table")
    op.add_column('agent_versions', sa.Column('agent_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE agent_versions av
        SET agent_uuid = am.new_uuid
        FROM agents_id_mapping am
        WHERE av.agent_id = am.old_id
    """)
    _migrate_table_to_uuid(
        table_name='agent_versions',
        foreign_keys=[
            {'old_col': 'agent_id', 'new_col': 'agent_uuid', 'ref_table': 'agents'}
        ],
    )

    print("\n  Processing: provider_versions table")
    op.add_column('provider_versions', sa.Column('provider_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE provider_versions pv
        SET provider_uuid = pm.new_uuid
        FROM llm_providers_id_mapping pm
        WHERE pv.provider_id = pm.old_id
    """)
    _migrate_table_to_uuid(
        table_name='provider_versions',
        foreign_keys=[
            {'old_col': 'provider_id', 'new_col': 'provider_uuid', 'ref_table': 'llm_providers'}
        ],
    )

    # ===================================================================
    # PROMPT TABLES (Already have UUID primary keys, just update FKs)
    # ===================================================================
    print("\n  Processing: prompt tables (updating foreign keys only)...")
    print("    Note: These tables already use UUID primary keys")

    # Update tenant_id and user_id in prompt tables
    for table in ['prompt_categories', 'prompt_templates', 'prompt_executions',
                  'prompt_favorites', 'prompt_ratings', 'prompt_feedback']:
        if table in ['prompt_templates', 'prompt_executions']:
            # These have both tenant_id and user_id
            op.execute(f"""
                ALTER TABLE {table}
                ALTER COLUMN tenant_id TYPE UUID USING tenant_id::text::uuid,
                ALTER COLUMN user_id TYPE UUID USING user_id::text::uuid
            """)
        elif table in ['prompt_categories']:
            # Only has tenant_id
            op.execute(f"""
                ALTER TABLE {table}
                ALTER COLUMN tenant_id TYPE UUID USING tenant_id::text::uuid
            """)
        elif table in ['prompt_favorites', 'prompt_ratings', 'prompt_feedback']:
            # Only has user_id
            op.execute(f"""
                ALTER TABLE {table}
                ALTER COLUMN user_id TYPE UUID USING user_id::text::uuid
            """)

    print("\n  Prompt tables foreign keys updated to UUID format")

    # ===================================================================
    # Association Tables (many-to-many)
    # ===================================================================
    print("\n  Processing association tables...")
    
    # agent_tools table
    print("    - agent_tools (agent_id, tool_id)")
    op.add_column('agent_tools', sa.Column('agent_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.add_column('agent_tools', sa.Column('tool_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE agent_tools at
        SET agent_uuid = am.new_uuid,
            tool_uuid = tm.new_uuid
        FROM agents_id_mapping am, tools_id_mapping tm
        WHERE at.agent_id = am.old_id
          AND at.tool_id = tm.old_id
    """)
    # Drop old columns
    op.drop_constraint('agent_tools_agent_id_fkey', 'agent_tools', type_='foreignkey')
    op.drop_constraint('agent_tools_tool_id_fkey', 'agent_tools', type_='foreignkey')
    op.drop_column('agent_tools', 'agent_id')
    op.drop_column('agent_tools', 'tool_id')
    # Rename UUID columns
    op.alter_column('agent_tools', 'agent_uuid', new_column_name='agent_id')
    op.alter_column('agent_tools', 'tool_uuid', new_column_name='tool_id')
    # Recreate constraints
    op.create_foreign_key('agent_tools_agent_id_fkey', 'agent_tools', 'agents', ['agent_id'], ['id'])
    op.create_foreign_key('agent_tools_tool_id_fkey', 'agent_tools', 'tools', ['tool_id'], ['id'])
    op.create_primary_key('agent_tools_pkey', 'agent_tools', ['agent_id', 'tool_id'])

    # crew_agents table
    print("    - crew_agents (crew_id, agent_id)")
    op.add_column('crew_agents', sa.Column('crew_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.add_column('crew_agents', sa.Column('agent_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE crew_agents ca
        SET crew_uuid = cm.new_uuid,
            agent_uuid = am.new_uuid
        FROM crews_id_mapping cm, agents_id_mapping am
        WHERE ca.crew_id = cm.old_id
          AND ca.agent_id = am.old_id
    """)
    # Drop old columns
    op.drop_constraint('crew_agents_crew_id_fkey', 'crew_agents', type_='foreignkey')
    op.drop_constraint('crew_agents_agent_id_fkey', 'crew_agents', type_='foreignkey')
    op.drop_column('crew_agents', 'crew_id')
    op.drop_column('crew_agents', 'agent_id')
    # Rename UUID columns
    op.alter_column('crew_agents', 'crew_uuid', new_column_name='crew_id')
    op.alter_column('crew_agents', 'agent_uuid', new_column_name='agent_id')
    # Recreate constraints
    op.create_foreign_key('crew_agents_crew_id_fkey', 'crew_agents', 'crews', ['crew_id'], ['id'])
    op.create_foreign_key('crew_agents_agent_id_fkey', 'crew_agents', 'agents', ['agent_id'], ['id'])
    op.create_primary_key('crew_agents_pkey', 'crew_agents', ['crew_id', 'agent_id'])

    # ===================================================================
    # Prompt Versions (has self-referential FK: parent_version_id)
    # ===================================================================
    print("\n  Processing: prompt_versions table")
    # Note: prompt_versions already has UUID primary key (id), only need to update:
    # - prompt_id FK (references prompt_templates)
    # - parent_version_id FK (self-referential)

    # Update prompt_id FK
    op.add_column('prompt_versions', sa.Column('prompt_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE prompt_versions pv
        SET prompt_uuid = pt.id
        FROM prompt_templates pt
        WHERE pv.prompt_id::text = pt.id::text
    """)
    op.drop_column('prompt_versions', 'prompt_id')
    op.alter_column('prompt_versions', 'prompt_uuid', new_column_name='prompt_id')
    op.alter_column('prompt_versions', 'prompt_id', nullable=False)
    op.create_foreign_key('prompt_versions_prompt_id_fkey', 'prompt_versions', 'prompt_templates', ['prompt_id'], ['id'])

    # Update parent_version_id FK (self-referential, nullable)
    op.add_column('prompt_versions', sa.Column('parent_version_uuid', postgresql.UUID(as_uuid=True), nullable=True))
    op.execute("""
        UPDATE prompt_versions pv1
        SET parent_version_uuid = pv2.id
        FROM prompt_versions pv2
        WHERE pv1.parent_version_id::text = pv2.id::text
    """)
    op.drop_column('prompt_versions', 'parent_version_id')
    op.alter_column('prompt_versions', 'parent_version_uuid', new_column_name='parent_version_id')
    op.create_foreign_key('prompt_versions_parent_version_id_fkey', 'prompt_versions', 'prompt_versions', ['parent_version_id'], ['id'])

    print("\n" + "=" * 80)
    print("UUID MIGRATION COMPLETE")
    print("✅  All 25 tables migrated from Integer IDs to UUIDs")
    print("=" * 80)
    print("\nMigrated tables:")
    print("  • Core entities: tenants, users, llm_providers, agents, crews, tasks, tools, flows")
    print("  • Execution: executions")
    print("  • Chat: chat_folders, chat_sessions")
    print("  • Notifications: notifications")
    print("  • Feedback: feedback")
    print("  • Versioning: agent_versions, provider_versions")
    print("  • Prompts: prompt_categories, prompt_templates, prompt_executions,")
    print("             prompt_favorites, prompt_ratings, prompt_feedback, prompt_versions")
    print("  • Association tables: agent_tools, crew_agents")
    print("=" * 80)


def _migrate_table_to_uuid(table_name, foreign_keys):
    """
    Helper function to complete UUID migration for a single table.

    Args:
        table_name: Name of the table
        foreign_keys: List of FK dicts with keys: old_col, new_col, ref_table
    """
    # Drop old integer ID and constraints
    try:
        op.drop_constraint(f'{table_name}_pkey', table_name, type_='primary_key')
    except:
        print(f"    - No PK constraint found for {table_name}")

    # Drop FK constraints for old integer columns
    for fk in foreign_keys:
        try:
            op.drop_constraint(f'{table_name}_{fk["old_col"]}_fkey', table_name, type_='foreignkey')
        except:
            print(f"    - No FK constraint found for {table_name}.{fk['old_col']}")
        try:
            op.drop_column(table_name, fk['old_col'])
        except:
            print(f"    - Column {fk['old_col']} already dropped (CASCADE)")

    # Drop old integer id column using CASCADE to handle dependent FKs
    op.execute(f'ALTER TABLE {table_name} DROP COLUMN id CASCADE')
    
    # Rename uuid column to id
    op.alter_column(table_name, 'uuid', new_column_name='id')
    
    # Rename UUID FK columns (remove _uuid suffix)
    for fk in foreign_keys:
        new_name = fk['old_col']  # e.g., tenant_id
        op.alter_column(table_name, fk['new_col'], new_column_name=new_name)
    
    # Set NOT NULL
    op.alter_column(table_name, 'id', nullable=False)
    for fk in foreign_keys:
        op.alter_column(table_name, fk['old_col'], nullable=False)
    
    # Create PK constraint
    op.create_primary_key(f'{table_name}_pkey', table_name, ['id'])
    
    # Recreate FK constraints
    for fk in foreign_keys:
        op.create_foreign_key(
            f'{table_name}_{fk["old_col"]}_fkey',
            table_name,
            fk['ref_table'],
            [fk['old_col']],
            ['id']
        )
    
    # Create index on id column (for B-tree performance)
    op.create_index(f'ix_{table_name}_id', table_name, ['id'])


def downgrade():
    """
    Downgrade is NOT supported for this migration.
    
    UUID → Integer conversion would lose data and break referential integrity.
    To rollback, restore from database backup taken before migration.
    """
    raise NotImplementedError(
        "UUID migration cannot be automatically rolled back. "
        "Restore from backup: psql crewai_platform < backup_before_uuid.sql"
    )
